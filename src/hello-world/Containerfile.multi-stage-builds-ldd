# syntax=docker/dockerfile:1.29.0
FROM public.ecr.aws/docker/library/rust:1.100.0-slim-trixie AS builder
COPY . .
RUN cargo build --release
RUN ldd /target/release/hello-world

FROM scratch
COPY --from=builder \
    /target/release/hello-world \
    /target/release/hello-world.dwp \
    /
ENTRYPOINT [ "/hello-world" ]
