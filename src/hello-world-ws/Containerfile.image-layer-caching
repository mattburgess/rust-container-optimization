# syntax=docker/dockerfile:1.28.0

ARG RUST_VERSION=1.99.1
ARG CARGO_BINSTALL_VERSION=1.26.1
ARG CARGO_BINSTALL_CHECKSUM=97d3fe139df2eb0947e9db09c129e4381847440a4622d2a94fc38ce4bd52f378
ARG CARGO_CHEF_VERSION=0.1.78

FROM public.ecr.aws/docker/library/rust:${RUST_VERSION}-slim-trixie AS chef
ARG CARGO_CHEF_VERSION
ARG CARGO_BINSTALL_VERSION
ARG CARGO_BINSTALL_CHECKSUM
RUN /usr/lib/apt/apt-helper download-file "https://github.com/cargo-bins/cargo-binstall/releases/download/v${CARGO_BINSTALL_VERSION}/cargo-binstall-x86_64-unknown-linux-gnu.tgz" /tmp/cargo-binstall.tgz \
    && echo "${CARGO_BINSTALL_CHECKSUM}  /tmp/cargo-binstall.tgz" | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/cargo-binstall.tgz \
    && rm /tmp/cargo-binstall.tgz
RUN cargo binstall --disable-telemetry -y cargo-chef@${CARGO_CHEF_VERSION}
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
RUN rustup target add x86_64-unknown-linux-musl
# Build dependencies
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --target=x86_64-unknown-linux-musl --recipe-path recipe.json
# Build app
COPY . .
RUN cargo build --release --target=x86_64-unknown-linux-musl

FROM scratch
COPY --from=builder \
    /app/target/x86_64-unknown-linux-musl/release/hello-world-ws \
    /app/target/x86_64-unknown-linux-musl/release/hello-world-ws.dwp \
    /
ENTRYPOINT [ "/hello-world-ws" ]
