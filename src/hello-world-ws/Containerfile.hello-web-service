# syntax=docker/dockerfile:1.28.0
FROM public.ecr.aws/docker/library/rust:1.99.1-slim-trixie AS builder
RUN rustup target add x86_64-unknown-linux-musl
COPY . .
RUN cargo build --release --target=x86_64-unknown-linux-musl

FROM scratch
COPY --from=builder \
    target/x86_64-unknown-linux-musl/release/hello-world-ws \
    target/x86_64-unknown-linux-musl/release/hello-world-ws.dwp \
    /
ENTRYPOINT [ "/hello-world-ws" ]
